        "diff": "--- upstream/corrclip_segmentor.py\n+++ repaired/corrclip_segmentor.py\n@@ -327,8 +327,17 @@\n             for index in ranks:\r\n                 instance_mask[(selected_masks[index - 1] == 1)] = int(index)\r\n         elif self.mask_generator_type == 'sam2':\r\n-            image = Image.open(img_path).convert(\"RGB\")\r\n-            image = np.array(image)\r\n+            from PIL import UnidentifiedImageError\r\n+            try:\r\n+                image = Image.open(img_path).convert(\"RGB\")\r\n+                image = np.array(image)\r\n+            except UnidentifiedImageError:\r\n+                # FLAIR uint8 RGB bands, identical to the frozen image loader.\r\n+                import rasterio\r\n+                with rasterio.open(img_path) as source:\r\n+                    image = np.moveaxis(source.read((1, 2, 3)), 0, -1)\r\n+                if image.dtype != np.uint8 or image.ndim != 3 or image.shape[-1] != 3:\r\n+                    raise ValueError(\"TIFF fallback requires uint8 RGB bands 1,2,3\")\r\n             with torch.inference_mode(), torch.autocast(\"cuda\", dtype=torch.float16):\r\n                 masks = self.mask_generator.generate(image)\r\n             instance_mask = np.zeros((image.shape[0], image.shape[1]), dtype=int)\r\n"
      }
